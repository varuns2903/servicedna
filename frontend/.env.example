# ==========================================
# ServiceDNA Frontend Environment Variables
# ==========================================

# The base URL for the ServiceDNA backend API (defaults to http://localhost:8080/api/v1)
VITE_API_URL=http://localhost:8080/api/v1

# The backend OAuth2 GitHub authorization endpoint (defaults to http://localhost:8080/oauth2/authorization/github)
VITE_AUTH_LOGIN_URL=http://localhost:8080/oauth2/authorization/github

# The backend WebSocket STOMP endpoint URL (defaults to ws://localhost:8080/ws-endpoint)
VITE_WS_URL=ws://localhost:8080/ws-endpoint
