# ==========================================
# ServiceDNA Frontend Environment Variables
# ==========================================

# The base URL for the ServiceDNA backend API (defaults to http://localhost:8080/api/v1)
VITE_API_URL=http://localhost:8080/api/v1

# The backend OAuth2 GitHub authorization endpoint (defaults to http://localhost:8080/oauth2/authorization/github)
VITE_AUTH_LOGIN_URL=http://localhost:8080/oauth2/authorization/github

# The backend's generic OIDC authorization endpoint. Only used when the backend reports SSO as
# enabled (i.e. OIDC_ISSUER_URI is set) — the login page's SSO button is hidden otherwise.
VITE_SSO_LOGIN_URL=http://localhost:8080/oauth2/authorization/oidc

# There is no separate WebSocket URL variable — the STOMP/SockJS endpoint is derived from
# VITE_API_URL above by replacing the /api/v1 suffix with /ws, so it always tracks the same host.
