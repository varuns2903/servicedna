# ==========================================
# ServiceDNA Backend Environment Variables
# ==========================================

# --- Infrastructure / Docker Compose overrides ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=servicedna
POSTGRES_PORT=5433
REDIS_PORT=6380
KAFKA_PORT=9092
ZOOKEEPER_PORT=2181
ZIPKIN_PORT=9411

# --- Server ---
PORT=8080

# --- CORS ---
# Comma-separated list of origins allowed to call the API (e.g. your deployed frontend's URL).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (PostgreSQL) ---
# If running externally, update these
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/servicedna
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- Caching (Redis) ---
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6380

# --- Kafka ---
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Zipkin (Tracing) ---
MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://localhost:9411/api/v2/spans

# --- Metrics (Datadog / New Relic) ---
DATADOG_ENABLED=false
DATADOG_API_KEY=your_datadog_api_key

NEW_RELIC_ENABLED=false
NEW_RELIC_API_KEY=your_new_relic_api_key
NEW_RELIC_ACCOUNT_ID=your_new_relic_account_id

# --- Authentication (GitHub OAuth2) ---
# Create an OAuth app in your GitHub Developer Settings:
# Homepage URL: http://localhost:5173
# Authorization callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# --- Security (JWT) ---
# A strong, 256-bit random string for signing JWT tokens
JWT_SECRET=your_super_secret_jwt_signing_key_that_is_at_least_256_bits_long
# Token expiration time in milliseconds (e.g., 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# --- Billing (Stripe) ---
# Your Stripe Test API Key (starts with sk_test_)
STRIPE_API_KEY=sk_test_your_stripe_secret_key
# The Webhook Secret generated by Stripe to verify webhook payloads (starts with whsec_)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# Stripe Price IDs for your subscription tiers
STRIPE_PRO_PRICE_ID=price_your_pro_tier_id
STRIPE_ENTERPRISE_PRICE_ID=price_your_enterprise_tier_id
